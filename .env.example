# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Yandex Cloud
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# Bitrix24
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_webhook_token/

# Allowed Telegram user IDs (comma-separated), leave empty to allow all
ALLOWED_USER_IDS=

# Webhook security (recommended: generate with `openssl rand -hex 32`)
WEBHOOK_SECRET=

# TTS: отправлять голосовой ответ на голосовые команды (true/false)
TTS_ENABLED=false

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bot.log
